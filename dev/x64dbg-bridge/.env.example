# 复制为 .env 后按本机路径修改（Git 勿提交 .env）
# cp .env.example .env

# x64dbg 解压根目录（内含 release/x64/x64dbg.exe）
X64DBG_ROOT=D:/WindowsOnly/Software/snapshot_2025-08-19_19-40

# 可选：直接指定 x64dbg.exe（未设置时默认 X64DBG_ROOT/release/x64/x64dbg.exe）
# X64DBG_EXE=

# 游戏客户端
H1Z1_EXE=D:/WindowsOnly/Games/H1EMU_Client/H1Z1.exe

# 传给 H1Z1.exe 的参数（与 start-2016-with-client.sh 一致，必须加引号便于 bash / Python 解析）
H1Z1_CMDLINE="sessionid=0 server=localhost:1115"

# daemon 监听（仅本机）
H1_X64DBG_DAEMON_HOST=127.0.0.1
H1_X64DBG_DAEMON_PORT=18765

# 启动 daemon 时是否自动：起 x64dbg 并在其下调试启动 H1Z1（推荐 true）
AUTO_START_SESSION=1

# 1=先普通启动 H1Z1（非调试器创建），H1_ATTACH_DELAY_SEC 秒后再 x64dbg 附加。直跑正常、调试却在入口 C0000005 时优先开此项。
H1_X64DBG_ATTACH=0
# 生成游戏进程后等待再附加（秒），过短可能仍踩早期检测；可试 8～15
H1_ATTACH_DELAY_SEC=6

# 会话建立后自动执行 run（越过系统/入口断点），否则游戏会一直停住像“挂掉”（推荐 1）
AUTO_GO_AFTER_START=1
# 连续 go 次数上限。闪屏后若停在「TLS 回调 / INT3 @ 14xxxxxxx」之类，说明又多了一处系统断点，可提到 10～12
# 或在 x64dbg：选项 → 事件 → 取消「TLS 回调」等断点，减少手动 F9
AUTO_GO_ROUNDS=12
# 初始连续 F9 时是否把异常交给目标（减轻 EXCEPTION_BREAKPOINT 停住）
AUTO_GO_PASS_EXCEPTIONS=1

# 启动 x64dbg 前自动写 ini [Events]：关闭 TLS 用户模块 + 系统模块（如 nvwgf2umx）上的 TLS 断点，免每次进 GUI
# 未设 X64DBG_INI 时：会修补「x64dbg.exe 同目录已存在的 x96dbg.ini/x64dbg.ini」+「%LOCALAPPDATA%\\x64dbg\\x96dbg.ini」（若存在）；若都不存在则在 exe 同目录新建 x96dbg.ini
# 写回可能丢失 ini 里注释/顺序，介意请改用手动选项或备份 ini
X64DBG_PATCH_TLS_EVENTS=1
# X64DBG_INI=D:/path/to/x96dbg.ini

# ---------- 反调试（需 install_scyllahide_plugin.sh；start-2016-with-client.sh 会自动尝试安装）----------
# 会话建立后执行 hide（ScyllaHide / x64dbg 清 PEB 等）
AUTO_HIDE_PEB=1
# 后台轮询：若停在 ud2（ILLEGAL_INSTRUCTION）等陷阱上，自动 NOP 并继续（对 H1Z1 加载期 ud2 有效）
AUTO_UNSTICK_STOPPED=1
AUTO_UNSTICK_SEC=420
AUTO_UNSTICK_INTERVAL_MS=280
AUTO_UNSTICK_MAX_PATCHES=800
# 是否也摘掉 RIP 上的 CC / CD03（默认关，避免误伤断点）
AUTO_UNSTICK_PATCH_INT3=0

# 日志目录（相对本目录或绝对路径）
LOG_DIR=logs

# 首次连接 x64dbg 时等待会话就绪的最长时间（秒）
SESSION_READY_TIMEOUT_SEC=90
